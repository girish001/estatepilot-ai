# EstatePilot AI — Production Environment Configuration Template
# NEVER commit real passwords, secrets, or tokens to Git.
# In AWS Production (ap-south-1), store secrets in AWS Secrets Manager / Systems Manager Parameter Store.
# NEVER store permanent admin passwords (e.g., ADMIN_PASSWORD) in runtime environment configuration.

# 1. Isolated PostgreSQL Database Connection & Pool Settings
# Runtime MUST connect to isolated database `estatepilot_ai` using least-privilege role `estatepilot_app`.
# Schema migrations (`npm run db:migrate`) MUST connect using dedicated role `estatepilot_migrator`.
DATABASE_URL=
EXPECTED_DB_NAME=estatepilot_ai
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# 2. Schema Migration & Dev Persistence Safety Guards (Fail-Closed by Default)
# Runtime application servers must ALWAYS keep ALLOW_SCHEMA_MIGRATION=false and ALLOW_DEV_PGLITE=false.
# Only explicit deployment migration jobs using `estatepilot_migrator` may set ALLOW_SCHEMA_MIGRATION=true.
ALLOW_SCHEMA_MIGRATION=false
ALLOW_DEV_PGLITE=false

# 3. Initial SUPER_ADMIN Provisioning (Fail-Closed One-Time Bootstrap Token)
# Required for one-time initial SUPER_ADMIN bootstrap (minimum 16 characters).
# If unset or empty, /api/auth/bootstrap fails closed with HTTP 503.
ADMIN_BOOTSTRAP_TOKEN=

# 4. Web & API Runtime Settings
API_HOST=
API_PORT=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ICE_SERVERS=
PUBLIC_WEB_ORIGIN=
WEB_ORIGIN=

# 5. Self-Hosted Voice & AI Agent Settings (Optional Phase 2 Worker)
OLLAMA_MODEL=
OLLAMA_URL=
PIPER_BIN=
PIPER_VOICE_EN=
PIPER_VOICE_HI=
PIPER_VOICE_KN=
PIPER_VOICE_TE=
REDIS_URL=
WHISPER_COMPUTE_TYPE=
WHISPER_DEVICE=
WHISPER_MODEL=