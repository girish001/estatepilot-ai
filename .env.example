# ==========================================
# EstatePilot AI - Environment Variables
# ==========================================

# Application URLs
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgresql://estatepilot:estatepilot_secret@localhost:5432/estatepilot_db
REDIS_URL=redis://localhost:6379

# Fastify Backend API
API_PORT=4000
API_HOST=0.0.0.0

# Speech Recognition & AI Language Model (Self-Hosted)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Multilingual Speech Synthesis (Piper TTS - 4 Languages)
PIPER_BIN=piper
PIPER_VOICE_EN=voices/en_US-lessac-medium.onnx
PIPER_VOICE_KN=voices/kn_IN-voice.onnx
PIPER_VOICE_TE=voices/te_IN-voice.onnx
PIPER_VOICE_HI=voices/hi_IN-voice.onnx