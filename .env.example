# EstatePilot AI — Environment Configuration Template
# NEVER commit real passwords, secrets, or tokens to Git.
# In AWS Production (ap-south-1), store secrets in AWS Secrets Manager / Systems Manager Parameter Store.

# 1. Isolated PostgreSQL Database Connection (Workstream 1 & 3)
# Must point to isolated database `estatepilot_ai` using least-privilege role `estatepilot_app`.
# Runtime safety guard blocks connections to Aurelia TimeFlow databases or RDS master accounts.
DATABASE_URL=
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# 2. Initial SUPER_ADMIN Provisioning (Used only once by `npm run db:provision-admin`)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# 3. Web & API Runtime Settings
API_HOST=
API_PORT=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ICE_SERVERS=
PUBLIC_WEB_ORIGIN=
WEB_ORIGIN=

# 4. Self-Hosted Voice & AI Agent Settings (Optional Phase 2 Worker)
OLLAMA_MODEL=
OLLAMA_URL=
PIPER_BIN=
PIPER_VOICE_EN=
PIPER_VOICE_HI=
PIPER_VOICE_KN=
PIPER_VOICE_TE=
REDIS_URL=
WHISPER_COMPUTE_TYPE=
WHISPER_DEVICE=
WHISPER_MODEL=