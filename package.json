{
  "name": "estatepilot-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "test": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/run-tests.ts",
    "db:migrate": "ALLOW_SCHEMA_MIGRATION=true node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/seed-reviewed.ts",
    "db:provision-admin": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/provision-first-admin.ts",
    "admin:provision": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/provision-first-admin.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/pg": "^8.23.1"
  }
}